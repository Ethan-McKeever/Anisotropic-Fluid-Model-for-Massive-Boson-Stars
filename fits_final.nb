Cell["Fitting Form", "Section",
 CellChangeTimes->{
  3.924385109176545*^9},ExpressionUUID->"ee0cab56-7be2-459a-b95f-\
8cdb46aaf5cc"],

Cell[TextData[{
 StyleBox["KY: corrected the meaning of x & y (previously, it was x:",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  OverscriptBox[
   RowBox[{" ", "\[Lambda]"}], "~"]],
  CellChangeTimes->{3.924385023515581*^9},
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "8c611969-5342-4c1a-924a-37cd9d968b50"],
 StyleBox[" and y: ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["\[Phi]", "~"], 
    RowBox[{"0", "c"}]], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "209aff1f-5afc-4926-a864-128767e6055f"],
 StyleBox[")",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.973096524335793*^9, 
  3.973096582250843*^9}},ExpressionUUID->"26b773ac-2409-4b7b-a97f-\
00625d137417"],

Cell[TextData[{
 "x: ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox[
     OverscriptBox["\[Phi]", "~"], 
     RowBox[{"0", "c"}]], 
    SqrtBox[
     RowBox[{"8", "\[Pi]"}]]], TraditionalForm]],ExpressionUUID->
  "e315d377-cf61-4955-a3c0-b791a057da72"],
 "\[LineSeparator]y: ",
 Cell[BoxData[
  OverscriptBox["\[Lambda]", "~"]],
  CellChangeTimes->{3.924385023515581*^9},ExpressionUUID->
  "be4958d5-2d13-4ffc-8537-c313962ec6a9"]
}], "Text",
 CellChangeTimes->{{3.924384999784832*^9, 3.924385035793496*^9}, 
   3.9730962420269947`*^9},ExpressionUUID->"cb1c902c-8003-41fb-8c2c-\
5ababf889c8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fit", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a0", "[", "i", "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a1", "[", "i", "]"}], " ", "y"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a2", "[", "i", "]"}], " ", 
         SuperscriptBox["y", "2"]}], "+", 
        RowBox[{
         RowBox[{"a3", "[", "i", "]"}], " ", 
         SuperscriptBox["y", "3"]}], "+", " ", 
        RowBox[{
         RowBox[{"a4", "[", "i", "]"}], " ", "y", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"y", "+", "1"}], "]"}]}], " ", "+", " ", 
        FractionBox[
         RowBox[{"a5", "[", "i", "]"}], 
         RowBox[{"y", "+", "1"}]]}], ")"}], 
      SuperscriptBox["x", 
       RowBox[{"i", "/", "2"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9243546927466593`*^9, 3.924354802168705*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"7d053df0-dff4-439f-a35c-22c1ef0c4b46"]
}, Open  ]],

