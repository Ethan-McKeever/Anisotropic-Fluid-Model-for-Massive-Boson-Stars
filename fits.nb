  3.924385109176545*^9},ExpressionUUID->"ee0cab56-7be2-459a-b95f-\
8cdb46aaf5cc"],

Cell[TextData[{
 "x: ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SubscriptBox[
     OverscriptBox["\[Phi]", "~"], 
     RowBox[{"0", "c"}]], 
    SqrtBox[
     RowBox[{"8", "\[Pi]"}]]], TraditionalForm]],ExpressionUUID->
  "e315d377-cf61-4955-a3c0-b791a057da72"],
