5ababf889c8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fit", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a0", "[", "i", "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a1", "[", "i", "]"}], " ", "y"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"a2", "[", "i", "]"}], " ", 
         SuperscriptBox["y", "2"]}], "+", 
        RowBox[{
         RowBox[{"a3", "[", "i", "]"}], " ", 
         SuperscriptBox["y", "3"]}], "+", " ", 
        RowBox[{
         RowBox[{"a4", "[", "i", "]"}], " ", "y", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"y", "+", "1"}], "]"}]}], " ", "+", " ", 
        FractionBox[
         RowBox[{"a5", "[", "i", "]"}], 
         RowBox[{"y", "+", "1"}]]}], ")"}], 
      SuperscriptBox["x", 
       RowBox[{"i", "/", "2"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9243546927466593`*^9, 3.924354802168705*^9}},
 CellLabel->
  "In[271]:=",ExpressionUUID->"7d053df0-dff4-439f-a35c-22c1ef0c4b46"]
}, Open  ]],

