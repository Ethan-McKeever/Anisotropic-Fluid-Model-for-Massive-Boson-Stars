Cell[TextData[{
 "In this notebook, we provide fitting forms for the anisotropy profile \
\[Sigma], the equation of state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "r"], "(", "\[Rho]", ")"}], TraditionalForm]],
  ExpressionUUID->"b54f3bca-b616-4392-be8b-961cf1aa6598"],
 ", and the radius ",
 StyleBox["R",
  FontSlant->"Italic"],
 "."
}], "Text",
